{
  "name": "eredivisie-daily-eleven",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:flags && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:dev": "wrangler dev --port 8787",
    "api:db:local": "wrangler d1 migrations apply eredivisie-eleven --local",
    "api:deploy": "wrangler deploy",
    "data:prepare": "py scripts/prepare_data.py",
    "data:flags": "node scripts/generate_flag_css.mjs"
  },
  "dependencies": {
    "flag-icons": "^7.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.156.2"
  }
}
